# API target for Vite dev server proxy (defaults to live https://api.rotaract3011.org if left unset)
# For local full-stack development, set this to http://127.0.0.1:3000
VITE_API_TARGET=https://api.rotaract3011.org

# Direct API origin (optional, if you want requests to bypass Vite dev proxy)
# VITE_API_ORIGIN=
